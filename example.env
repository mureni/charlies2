# Uncomment the below options and replace the values with your own authorization tokens, IDs, values, etc.
# Reminder: quotation marks are not necessary; if you add them they will be considered part of the values


# DISCORD_AUTH=[Your Discord authorization token]
# BOT_OWNER_DISCORD_ID=[Bot owner's Discord ID (from User Settings -> My Account -> ... -> Copy ID)]
# BOT_NAME=[Your bot's name]
# NODE_ENV=production
# DATA_DIR=./data
# AMBIENT_BOT_NAME_TRIGGER=true
# TOPIC_MEMORY_SALT=[Required to enable anonymized temporal topic memory]
# TRACE_SURPRISE=1
# HARNESS_PROXY_ENABLED=0
# HARNESS_PROXY_TOKEN=[Required when harness proxy is enabled]
# HARNESS_PROXY_ALLOW_PROD=0
# HARNESS_PROXY_ALLOW_REMOTE=0
# HARNESS_PROXY_IP_ALLOWLIST=127.0.0.1,::1
# HARNESS_PROXY_MAX_BODY_BYTES=1048576
# HARNESS_PROXY_RATE_LIMIT_MAX_REQUESTS=120
# HARNESS_PROXY_RATE_LIMIT_WINDOW_MS=60000
# HARNESS_PROXY_TRUST_CALLER_ROLES=0
# BOT_ROOT=[Optional override for where the bot reads dev/admin-portal/resources]
# ADMIN_PORTAL_PORT=3140
# ADMIN_PORTAL_HOST=127.0.0.1

# Test helpers
# TEST_KEEP_DB=1
# TEST_DUMP_DB=1
